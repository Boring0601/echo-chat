# 可选：接入 OpenAI 兼容的大模型。留空则使用内置本地人格引擎，完全离线可用。
# 复制本文件为 .env 后填写，重启 `node server.mjs` 生效。

# DeepSeek（推荐，中文对话自然）
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 或者使用任意 OpenAI 兼容服务：
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 本地端口（可选，默认 4173；被占用时会自动尝试后面的端口）
# PORT=4173
# HOST=127.0.0.1
